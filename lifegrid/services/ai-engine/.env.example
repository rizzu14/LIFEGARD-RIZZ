# ── Server ────────────────────────────────────────────────────
PORT=5001
DEBUG=false

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:4000

# ── Model paths ───────────────────────────────────────────────
MODELS_DIR=./models
NLP_MODEL_NAME=distilbert-base-uncased
FACE_MODEL_PATH=./models/arcface.onnx
FLOOD_MODEL_PATH=./models/flood_unet.pt
SAFETY_MODEL_PATH=./models/safety_svm.joblib

# ── FAISS index ───────────────────────────────────────────────
FACE_INDEX_PATH=./data/face_index.faiss
FACE_METADATA_PATH=./data/face_metadata.json

# ── Thresholds ────────────────────────────────────────────────
NLP_CONFIDENCE_THRESHOLD=0.55
FACE_SIMILARITY_THRESHOLD=0.65
SAFETY_ALERT_LATENCY_MS=3000
FLOOD_RISK_THRESHOLD=0.70
